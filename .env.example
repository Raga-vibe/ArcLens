# ─── Public (exposed to the browser) ─────────────────────────────────────────
# Canonical site URL, used for metadata, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=https://arclens.example.com
NEXT_PUBLIC_GITHUB_URL=https://github.com/your-handle/arclens
NEXT_PUBLIC_X_URL=https://x.com/your-handle
# Optional contact email shown on /privacy and /terms.
NEXT_PUBLIC_CONTACT_EMAIL=
# Optional cookieless analytics (Plausible). Leave empty to disable analytics entirely.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
# Optional override for the ArcLensRegistry address (defaults to its CREATE2 address). Public, not a secret.
NEXT_PUBLIC_REGISTRY_ADDRESS=

# ─── Server-only (never prefix with NEXT_PUBLIC_) ─────────────────────────────
# Comma-separated Arc mainnet JSON-RPC URLs. These may contain provider API keys.
# Default: https://rpc.mainnet.arc.io (public RPC: ~2.5 req/s, 10k blocks per log query)
ARC_RPC_URLS=
# Max inclusive block span per eth_getLogs call. Public RPCs cap at 10000.
# Raise it only if your provider supports larger ranges.
ARC_LOG_BLOCK_RANGE=10000
# Parallel requests per RPC endpoint, and minimum spacing between them (ms).
ARC_RPC_CONCURRENCY=3
ARC_RPC_MIN_INTERVAL_MS=380
ARC_RPC_TIMEOUT_MS=15000
# Largest analysis window this deployment serves: 24h | 3d | 7d | 30d | all
ARC_MAX_WINDOW=3d
# Wallet analyses allowed per IP per minute.
ARC_RATE_LIMIT_PER_MINUTE=12

# ─── Robinhood Chain Testnet (server-only) ────────────────────────────────────
# Defaults to Robinhood's official public testnet RPC. Use comma-separated
# provider endpoints for higher throughput; URLs may contain provider API keys.
ROBINHOOD_RPC_URLS=
ROBINHOOD_RPC_CONCURRENCY=2
ROBINHOOD_RPC_MIN_INTERVAL_MS=250
ROBINHOOD_RPC_TIMEOUT_MS=15000
# Server-side indexed activity API hosted by Robinhood's testnet explorer.
ROBINHOOD_EXPLORER_API_URL=https://explorer.testnet.chain.robinhood.com/api/v2
# Stop if the explorer has more pages than this so reports are never silently partial.
ROBINHOOD_MAX_EXPLORER_PAGES=200
# Supported windows for Robinhood testnet: 24h | 3d | 7d | 30d | all
ROBINHOOD_MAX_WINDOW=3d
